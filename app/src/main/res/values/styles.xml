<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher draws over the live wallpaper, so the window itself is
         transparent. No splash theme: there is no engine to wait for. -->
    <style name="Theme.Transparent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
